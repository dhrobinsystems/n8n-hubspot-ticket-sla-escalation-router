# =============================================================================
# n8n-hubspot-ticket-sla-escalation-router: environment template
# -----------------------------------------------------------------------------
# Copy to .env (never commit .env) and load these variables into the n8n
# process (docker-compose `env_file`, systemd EnvironmentFile, or your host's
# secret manager).
#
# Credentials are NOT configured here. HubSpot, Slack and SMTP credentials live
# in the n8n credential store and are selected on the nodes after import.
#
# n8n must allow Code nodes to read environment variables:
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# If you keep env access blocked, the router runs on the safe defaults below
# (including SANDBOX_MODE=true).
# =============================================================================

# --- Safety ------------------------------------------------------------------
# true  = evaluate tickets and log planned actions only (no writes, no messages)
# false = live: update tickets, create tasks, post to Slack, send email
SANDBOX_MODE=true

# --- HubSpot -----------------------------------------------------------------
# Numeric portal (hub) ID, used only to build ticket links in notifications.
HUBSPOT_PORTAL_ID=your-portal-id
# Restrict monitoring to one ticket pipeline (blank = all pipelines).
HUBSPOT_PIPELINE_ID=
# Base URL for ticket links (EU data-centre portals may use https://app-eu1.hubspot.com).
HUBSPOT_APP_BASE_URL=https://app.hubspot.com
# Owner ID that receives escalation tasks for tickets with no owner (blank = leave unassigned).
HUBSPOT_FALLBACK_OWNER_ID=
# Association type ID for task -> ticket (HubSpot-defined). Verify against HubSpot's association reference.
HUBSPOT_TASK_TICKET_ASSOCIATION_TYPE_ID=230
# Ticket property holding the first agent reply timestamp.
HUBSPOT_FIRST_RESPONSE_PROPERTY=first_agent_reply_date
# Search page size (max 200) and hard cap on tickets evaluated per run.
HUBSPOT_SEARCH_PAGE_SIZE=100
MAX_TICKETS_PER_RUN=500

# --- SLA tiers (hours) -------------------------------------------------------
SLA_P1_FIRST_RESPONSE_HOURS=1
SLA_P1_RESOLUTION_HOURS=8
SLA_P2_FIRST_RESPONSE_HOURS=4
SLA_P2_RESOLUTION_HOURS=24
SLA_P3_FIRST_RESPONSE_HOURS=8
SLA_P3_RESOLUTION_HOURS=72
# Tier used when a ticket has no priority or an unmapped one.
SLA_DEFAULT_TIER=P3
# HubSpot hs_ticket_priority value -> SLA tier.
SLA_PRIORITY_MAP=URGENT:P1,HIGH:P1,MEDIUM:P2,LOW:P3
# % of the target consumed at which a ticket becomes WARNING (<100) and CRITICAL (>100).
SLA_WARNING_THRESHOLD_PCT=80
SLA_CRITICAL_THRESHOLD_PCT=150

# --- Business hours ----------------------------------------------------------
# false = SLA clocks run 24/7. true = only count the business window below.
SLA_BUSINESS_HOURS_ONLY=false
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
# Weekday numbers, 0 = Sunday ... 6 = Saturday.
BUSINESS_DAYS=1,2,3,4,5
# Fixed offset of the support desk from UTC, in minutes (e.g. -300, 0, 60, 360).
BUSINESS_TZ_OFFSET_MINUTES=0

# --- Escalation policy -------------------------------------------------------
# Levels: 1 = WARNING, 2 = BREACHED, 3 = CRITICAL.
# Minimum hours between repeat notifications for a ticket at the same level.
ESCALATION_COOLDOWN_HOURS=4
ESCALATION_SLACK_MIN_LEVEL=1
ESCALATION_EMAIL_MIN_LEVEL=3
ESCALATION_TASK_MIN_LEVEL=2
# Escalation task due date = now + N hours.
ESCALATION_TASK_DUE_HOURS=2
# Set false to keep ticket subjects out of Slack, email and task bodies.
INCLUDE_TICKET_SUBJECT=true

# --- Escalation channels -----------------------------------------------------
ENABLE_SLACK=true
SLACK_CHANNEL=#support-escalations
# Optional mention added when a CRITICAL ticket is present, e.g. <!subteam^YOUR_GROUP_ID> or <!here>.
SLACK_SENIOR_MENTION=
# Fallback incoming webhook used only if the Slack node fails (read directly by the HTTP node).
SLACK_FALLBACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

ENABLE_EMAIL=true
ESCALATION_EMAIL_FROM=sla-bot@example.com
# Comma-separated. Receives every email-level escalation.
ESCALATION_EMAIL_TO=support-managers@example.com
# Comma-separated. Added only when the digest contains a CRITICAL ticket.
SENIOR_MANAGER_EMAILS=senior-manager@example.com

ENABLE_HUBSPOT_TASKS=true
ENABLE_TICKET_UPDATES=true

# --- Custom HubSpot ticket properties (create these before going live) --------
PROP_ESCALATION_LEVEL=sla_escalation_level
PROP_LAST_ESCALATED_AT=sla_last_escalated_at
PROP_SLA_STATUS=sla_status
